{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meuvascao",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Data limitada pelo workerd embutido no @cloudflare/vitest-pool-workers (1.20260815). Ao subir a
  // data aqui, suba também em tests/workers/wrangler.test.jsonc e confirme que o pool a aceita.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Ambiente padrão: desenvolvimento local. Bindings e vars não são herdados pelos envs abaixo;
  // por isso cada ambiente redeclara o que precisa.
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_URL": "http://localhost:4321",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meuvascao-dev",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "preview": {
      // Worker meuvascao-preview em workers.dev; versões por PR ganham alias `pr-<n>` (deploy.yml).
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "ENVIRONMENT": "preview",
        // Ajustar para a URL real do preview (workers.dev da conta ou um subdomínio próprio)
        // quando ela existir; só passa a ser usada em canonical/OG a partir da fatia F8.
        "SITE_URL": "https://meuvascao-preview.ovictoraurelio.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "meuvascao-preview",
          "database_id": "f4f3f50d-da5f-4421-b22c-8c57f93ac554",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      // Só pelo domínio próprio (a zona precisa estar na Cloudflare); nada em workers.dev.
      "workers_dev": false,
      "routes": [{ "pattern": "meuvascao.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://meuvascao.com",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "meuvascao-prod",
          "database_id": "b0221b14-4f31-477f-94b7-2cf8d0238a12",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
