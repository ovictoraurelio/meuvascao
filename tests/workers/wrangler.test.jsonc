{
  // Configuração mínima para os testes em workerd: só o que os repositórios precisam.
  "name": "meuvascao-tests",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_URL": "http://localhost:4321",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meuvascao-test",
      "database_id": "meuvascao-test",
      "migrations_dir": "migrations",
    },
  ],
}
