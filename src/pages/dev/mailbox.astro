---
import { getRequestDb } from "@/lib/db/client";
import { isProduction } from "@/lib/env";
import { listRecentDevMailboxMessages } from "@/modules/identidade";
import Base from "../../layouts/Base.astro";

// Só fora de produção — verificado em runtime por ENVIRONMENT (CLAUDE.md #7).
if (isProduction()) {
  return Astro.rewrite("/404");
}

const db = getRequestDb();
// ?to= filtra pelo destinatário exato — útil para o E2E (várias fatias pedindo link ao mesmo
// tempo) e para achar uma mensagem específica manualmente sem rolar a lista.
const to = Astro.url.searchParams.get("to") ?? undefined;
const messages = await listRecentDevMailboxMessages(db, { to });
---

<Base
  title="Caixa de e-mail (dev) — Meu Vascão"
  description="Só existe fora de produção: destino dos links mágicos enquanto não há Resend configurado."
>
  <div class="mailbox">
    <h1>Caixa de e-mail de desenvolvimento</h1>
    {
      messages.length === 0 ? (
        <p>Nenhuma mensagem ainda.</p>
      ) : (
        <ul>
          {messages.map((message) => (
            <li>
              <p class="para">Para: {message.to}</p>
              <p class="assunto">{message.subject}</p>
              <a href={message.link}>Entrar</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .mailbox {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--color-paper-muted);
  }

  .para {
    font-size: var(--type-sm);
    color: var(--color-ink-muted);
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--size-tap-target-min);
    color: var(--color-paper);
    background-color: var(--color-accent);
    padding-inline: var(--space-4);
    border-radius: var(--radius-sm);
    align-self: flex-start;
  }
</style>
