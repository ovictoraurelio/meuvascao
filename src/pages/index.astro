---
import { getEnv } from "@/lib/env";
import EstadoVazio from "../layouts/EstadoVazio.astro";

const { ENVIRONMENT } = getEnv();
---

<EstadoVazio
  title="Meu Vascão"
  description="Portal independente de torcedores do Vasco: dia de jogo, resenha e links curados."
  active="inicio"
  heading="Meu Vascão"
  message="Em construção. Ainda não há jogos, notícias ou resenha cadastrados."
>
  {
    ENVIRONMENT !== "production" && (
      <p>Ambiente: {ENVIRONMENT}. Esta página não é indexada.</p>
    )
  }
</EstadoVazio>
