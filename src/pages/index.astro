---
// Esqueleto da fatia F0. Layout, tokens e barra inferior entram na fatia F2.
import { getEnv } from "@/lib/env";

const { ENVIRONMENT } = getEnv();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Meu Vascão</title>
    <meta
      name="description"
      content="Portal independente de torcedores do Vasco: dia de jogo, resenha e links curados."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <h1>Meu Vascão</h1>
      <p>
        Portal independente, feito por torcedores, sem vínculo oficial com o
        Club de Regatas Vasco da Gama.
      </p>
      <p>Em construção. Ainda não há jogos, notícias ou resenha cadastrados.</p>
      {
        ENVIRONMENT !== "production" && (
          <p>Ambiente: {ENVIRONMENT}. Esta página não é indexada.</p>
        )
      }
    </main>
  </body>
</html>
