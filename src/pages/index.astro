---
import { getEnv } from "@/lib/env";
import Base from "../layouts/Base.astro";

const { ENVIRONMENT } = getEnv();
---

<Base
  title="Meu Vascão"
  description="Portal independente de torcedores do Vasco: dia de jogo, resenha e links curados."
  active="inicio"
>
  <div class="home">
    <h1>Meu Vascão</h1>
    <p>Em construção. Ainda não há jogos, notícias ou resenha cadastrados.</p>
    {ENVIRONMENT !== "production" && <p>Ambiente: {ENVIRONMENT}.</p>}
  </div>
</Base>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4);
  }
</style>
