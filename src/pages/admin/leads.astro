---
import { actions } from "astro:actions";
import { getRequestDb } from "@/lib/db/client";
import { requireRole } from "@/modules/administracao";
import Admin from "../../layouts/Admin.astro";
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
try {
  await requireRole(getRequestDb(), Astro.locals.session, ["admin"]);
} catch {
  return new Response("Acesso restrito à equipe autorizada.", {
    status: 403,
    headers: {
      "Cache-Control": "private, no-store",
      "X-Robots-Tag": "noindex, nofollow",
    },
  });
}
const result = Astro.getActionResult(actions.admin.exportarLeads);
---

<Admin title="Exportar contatos">
  <p>
    Apenas administradores. A exportação é registrada; use os contatos conforme
    o consentimento recebido.
  </p>
  <form method="POST" action={actions.admin.exportarLeads}>
    <button type="submit">Gerar CSV</button>
  </form>
  {result?.error && <p role="alert">{result.error.message}</p>}
  {
    result?.data && (
      <a
        download="meuvascao-contatos.csv"
        href={`data:text/csv;charset=utf-8,${encodeURIComponent(result.data.csv)}`}
      >
        Baixar CSV
      </a>
    )
  }
</Admin>
