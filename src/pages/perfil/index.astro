---
import { getRequestDb } from "@/lib/db/client";
import { getAuthenticatedUser } from "@/modules/identidade";
import Base from "../../layouts/Base.astro";

const db = getRequestDb();
const authenticated = await getAuthenticatedUser(db, Astro.locals.session);
if (!authenticated) {
  return Astro.redirect(
    `/entrar?redirect=${encodeURIComponent(Astro.url.pathname)}`,
  );
}
const { user } = authenticated;
---

<Base
  title="Perfil — Meu Vascão"
  description="Sua conta no Meu Vascão."
  active="perfil"
>
  <div class="perfil">
    <h1>Perfil</h1>
    <p class="apelido">{user.nickname}</p>
    {
      user.status === "suspended" && (
        <section aria-label="Suspensão da conta">
          <h2>Sua conta está suspensa</h2>
          <p>
            {user.suspendedReason ??
              "A moderação suspendeu as suas publicações."}
          </p>
          <p>
            Você pode continuar lendo. Consulte as{" "}
            <a href="/regras-da-resenha">regras da resenha</a>.
          </p>
        </section>
      )
    }

    {
      user.role !== "torcedor" && user.status === "active" && (
        <a href="/admin">Área da equipe</a>
      )
    }

    <form method="POST" action="/auth/logout">
      <button type="submit">Sair</button>
    </form>

    <form method="POST" action="/auth/logout">
      <input type="hidden" name="escopo" value="todos" />
      <button type="submit">Sair de todos os dispositivos</button>
    </form>

    <a href="/conta/excluir">Excluir conta</a>
    <a href="/conta/exportar.json">Exportar meus dados</a>
  </div>
</Base>

<style>
  .perfil {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4);
  }

  .apelido {
    font-family: var(--font-display);
    font-size: var(--type-xl);
    font-weight: var(--font-display-weight);
  }

  button,
  a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--size-tap-target-min);
    padding-inline: var(--space-4);
    color: var(--color-ink);
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-sm);
  }
</style>
