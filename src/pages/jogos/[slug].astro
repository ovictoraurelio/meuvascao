---
import { actions } from "astro:actions";
import { communityEnabled } from "@/lib/env";
import { findThread, listComments, writingClosed } from "@/modules/comunidade";
import { getAuthenticatedUser } from "@/modules/identidade";
import Resenha from "../../components/comunidade/Resenha.astro";
import { getRequestDb } from "@/lib/db/client";
import { formatKickoff } from "@/lib/match-kickoff";
import { MATCH_STATUS_LABEL } from "@/lib/match-status-label";
import { formatBRT } from "@/lib/time/brt";
import { findMatchBySlug } from "@/modules/partidas";
import Base from "../../layouts/Base.astro";

const { slug } = Astro.params;
const db = getRequestDb();
const match = slug ? await findMatchBySlug(db, slug) : null;

if (!match) {
  return Astro.rewrite("/404");
}

const LOCAL_TEXT: Record<"casa" | "fora" | "neutro", string> = {
  casa: "em casa",
  fora: "fora de casa",
  neutro: "em campo neutro",
};

// Só a checagem stateless do cookie (sem D1): uma sessão revogada só é pega de verdade quando
// a resenha (F8) tentar publicar um comentário de fato. Aqui o pior caso é o link levar à seção
// em vez de a /entrar — inofensivo enquanto não existe formulário de comentário.
const comentarHref = "#comentar";
const enabled = communityEnabled();
const auth = await getAuthenticatedUser(db, Astro.locals.session);
const thread = await findThread(db, match.id);
let page;
try {
  page = await listComments(db, match.id, Astro.url.searchParams.get("cursor"));
} catch {
  return new Response("Cursor inválido.", { status: 400 });
}
const posted = Astro.getActionResult(actions.comunidade.comentar);
const liked = Astro.getActionResult(actions.comunidade.curtir);
const reported = Astro.getActionResult(actions.comunidade.denunciar);
const loginHref = `/entrar?redirect=${encodeURIComponent(`${Astro.url.pathname}#comentar`)}`;
---

<Base
  title={`Vasco x ${match.opponentName} — Meu Vascão`}
  description={`${match.competition}: Vasco ${LOCAL_TEXT[match.homeAway]} contra ${match.opponentName}.`}
  active="jogos"
>
  <article class="jogo">
    <p class="competicao">{match.competition}</p>
    <h1>
      Vasco {match.homeAway === "casa" ? "x" : "×"}{" "}
      {match.opponentName}
    </h1>
    {
      MATCH_STATUS_LABEL[match.status] && (
        <p class="status">{MATCH_STATUS_LABEL[match.status]}</p>
      )
    }
    <p class="horario" data-testid="horario">
      {formatKickoff(match)}
      {match.venue && ` · ${match.venue}`}
    </p>
    {
      match.status === "encerrado" && (
        <p data-testid="placar" class="placar">
          Vasco {match.scoreVasco} x {match.scoreOpponent} {match.opponentName}
        </p>
      )
    }
    {
      match.sourceName && (
        <p class="fonte">
          Fonte: {match.sourceName}
          {match.sourceUrl && (
            <>
              {" "}
              ·{" "}
              <a
                href={match.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Ler na fonte
              </a>
            </>
          )}
        </p>
      )
    }
    <p class="atualizacao">
      Última atualização: {formatBRT(match.updatedAt)}
    </p>

    <a href={comentarHref} class="cta-comentar"> Comentar </a>

    <Resenha
      matchId={match.id}
      enabled={enabled}
      postingOpen={thread?.status !== "closed" && !(await writingClosed(db))}
      canWrite={!!auth && auth.user.status === "active" && !!auth.user.nickname}
      loginHref={loginHref}
      items={page.items}
      nextCursor={page.nextCursor}
      endCursor={page.endCursor}
      parentId={Astro.url.searchParams.get("responder") ?? undefined}
      error={posted?.error?.message ??
        liked?.error?.message ??
        reported?.error?.message}
      published={posted?.data?.id}
      notice={reported?.data
        ? "Denúncia enviada para a moderação."
        : liked?.data
          ? "Curtida registrada."
          : undefined}
    />
  </article>
</Base>

<style>
  .jogo {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
  }

  .competicao {
    font-size: var(--type-sm);
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status {
    display: inline-block;
    align-self: flex-start;
    padding-inline: var(--space-2);
    font-size: var(--type-sm);
    color: var(--color-paper);
    background-color: var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .placar {
    font-family: var(--font-display);
    font-size: var(--type-2xl);
    font-weight: var(--font-display-weight);
  }

  .fonte,
  .atualizacao {
    font-size: var(--type-sm);
    color: var(--color-ink-muted);
  }

  .cta-comentar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-block-size: var(--size-tap-target-min);
    margin-block-start: var(--space-2);
    padding-inline: var(--space-4);
    color: var(--color-paper);
    background-color: var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .cta-comentar:hover {
    text-decoration: none;
  }

  .resenha {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-paper-muted);
  }

  .fonte a {
    text-decoration: underline;
  }
</style>
