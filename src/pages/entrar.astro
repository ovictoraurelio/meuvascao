---
import { actions } from "astro:actions";

import { publicSignupsEnabled } from "@/lib/env";
import { safeRedirectTarget } from "@/lib/http/redirect-safe";
import Turnstile from "../components/ui/Turnstile.astro";
import Base from "../layouts/Base.astro";

const signupsEnabled = publicSignupsEnabled();
const redirectParam = safeRedirectTarget(
  Astro.url.searchParams.get("redirect"),
);
const result = Astro.getActionResult(actions.identidade.pedirLinkMagico);
---

<Base
  title="Entrar — Meu Vascão"
  description="Entre com um link enviado para o seu e-mail, sem senha."
>
  <div class="entrar">
    <h1>Entrar</h1>
    {
      signupsEnabled ? (
        <>
          <p>
            Enviamos um link de acesso para o seu e-mail — sem senha para
            lembrar.
          </p>

          <form method="POST" action={actions.identidade.pedirLinkMagico}>
            {redirectParam && (
              <input type="hidden" name="redirect" value={redirectParam} />
            )}

            <label for="entrar-email">E-mail</label>
            <input id="entrar-email" name="email" type="email" required />

            <Turnstile />

            <button type="submit">Enviar link de acesso</button>
          </form>
        </>
      ) : (
        <p>
          Acesso por e-mail temporariamente indisponível. Você pode acompanhar
          os jogos e as notícias sem entrar.
        </p>
      )
    }
    <p>Consulte o <a href="/privacidade">aviso de privacidade</a>.</p>

    {result?.error && <p role="alert">{result.error.message}</p>}
    {
      result?.data?.ok && (
        <p role="status">Verifique seu e-mail: enviamos um link de acesso.</p>
      )
    }
  </div>
</Base>

<style>
  .entrar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-4);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-inline-size: 28rem;
  }

  input[type="email"] {
    min-block-size: var(--size-tap-target-min);
    padding-inline: var(--space-2);
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-sm);
  }

  button {
    min-block-size: var(--size-tap-target-min);
    padding-inline: var(--space-4);
    color: var(--color-paper);
    background-color: var(--color-accent);
    border-radius: var(--radius-sm);
  }
</style>
