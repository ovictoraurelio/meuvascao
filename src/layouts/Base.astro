---
import "@fontsource-variable/dm-sans/wght.css";
import "@fontsource/barlow-condensed/latin-700.css";
import "@fontsource/barlow-condensed/latin-ext-700.css";
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/base.css";

import { NAV, type NavKey } from "@/lib/nav";
import Meta from "../components/seo/Meta.astro";
import Faixa from "../components/ui/Faixa.astro";

interface Props {
  title: string;
  description: string;
  active?: NavKey;
}

const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <Meta title={title} description={description} />
  </head>
  <body>
    <p class="disclaimer">
      Portal independente, feito por torcedores. Sem vínculo oficial com o Club
      de Regatas Vasco da Gama.
    </p>
    <a href="/" class="marca">
      <img src="/brand/simbolo.svg" alt="" width="28" height="28" />
      <span>Meu Vascão</span>
    </a>
    <Faixa />
    <main>
      <slot />
    </main>
    <footer class="institucionais">
      <a href="/sobre">Sobre</a>
      <a href="/regras-da-resenha">Regras da resenha</a>
      <a href="/privacidade">Privacidade</a>
    </footer>
    <nav class="barra-inferior" aria-label="Navegação principal">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={active === item.key ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </body>
</html>

<style>
  .institucionais {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .institucionais a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--size-tap-target-min);
  }

  body {
    display: flex;
    flex-direction: column;
    min-block-size: 100vh;
  }

  /* Legível no topo mobile (docs/02:9): não é letra miúda de rodapé. */
  .disclaimer {
    padding: var(--space-2) var(--space-4);
    font-size: var(--type-sm);
    color: var(--color-ink-muted);
    text-align: center;
    background-color: var(--color-paper);
  }

  .marca {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    justify-content: center;
    padding-block: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--type-lg);
    font-weight: var(--font-display-weight);
    color: var(--color-ink);
  }

  .marca:hover {
    text-decoration: none;
  }

  main {
    flex: 1;
    padding-block-end: var(--space-8);
  }

  .barra-inferior {
    /* Em fluxo: a navegação não cobre links do rodapé durante a rolagem. */
    flex-shrink: 0;
    background-color: var(--color-ink);
    border-block-start: 1px solid var(--color-accent);
  }

  .barra-inferior ul {
    display: flex;
  }

  .barra-inferior li {
    flex: 1;
  }

  .barra-inferior a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--size-tap-target-min);
    padding-inline: var(--space-2);
    font-size: var(--type-sm);
    color: var(--color-paper-muted);
    text-align: center;
  }

  .barra-inferior a:hover {
    color: var(--color-paper);
    text-decoration: none;
  }

  .barra-inferior a[aria-current="page"] {
    color: var(--color-paper);
    font-weight: var(--font-display-weight);
  }
</style>
