---
// Faixa diagonal (docs/02): recurso de composição da marca, puramente decorativo — sem texto, sem
// papel interativo. `aria-hidden` porque não carrega nenhuma informação que não esteja já no
// conteúdo ao redor.
interface Props {
  variant?: "acento" | "escura";
}

const { variant = "acento" } = Astro.props;
---

<div
  class:list={["faixa", { escura: variant === "escura" }]}
  aria-hidden="true"
>
</div>

<style>
  .faixa {
    /* Ângulo e ponto de corte da diagonal: uma só definição para as duas variantes, que só trocam
       a ordem das duas cores. */
    --faixa-angulo: 100deg;
    --faixa-corte: 60%;
    --faixa-cor-a: var(--color-accent);
    --faixa-cor-b: var(--color-ink);

    block-size: var(--space-2);
    background: linear-gradient(
      var(--faixa-angulo),
      var(--faixa-cor-a) 0%,
      var(--faixa-cor-a) var(--faixa-corte),
      var(--faixa-cor-b) var(--faixa-corte),
      var(--faixa-cor-b) 100%
    );
  }

  .faixa.escura {
    --faixa-cor-a: var(--color-ink);
    --faixa-cor-b: var(--color-accent);
  }
</style>
