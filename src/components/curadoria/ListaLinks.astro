---
import { formatBRT } from "@/lib/time/brt";

const LABEL_TEXT: Record<string, string> = {
  noticia: "Notícia",
  opiniao: "Opinião",
  rumor: "Rumor",
  video: "Vídeo",
  podcast: "Podcast",
};

// Forma estrutural, não importada de @/modules/curadoria: componentes de apresentação não
// importam módulos de domínio (eslint no-restricted-imports), mesmo só para o tipo.
interface LinkCurado {
  url: string;
  title: string;
  sourceName: string;
  label: string;
  publishedAt: Date | null;
  createdAt: Date;
}

interface Props {
  heading: string;
  links: LinkCurado[];
  testId: string;
  // Sem uma discussão por link (fora do escopo da v1): "Comentar" leva à mesma resenha central
  // do próximo jogo. Sem próximo jogo cadastrado, só "Ler na fonte" aparece.
  comentarHref: string | null;
}

const { heading, links, testId, comentarHref } = Astro.props;
---

<section aria-label={heading} class="editorial-list">
  <h2>{heading}</h2>
  {
    links.length === 0 ? (
      <div class="empty-editorial">
        <>
          <span aria-hidden="true">↗</span>
          <p>Ainda não há links cadastrados aqui.</p>
          <p class="meta">
            Notícias, contexto e a fonte original. A seleção aparece por aqui.
          </p>
        </>
      </div>
    ) : (
      <ul data-testid={testId}>
        {links.map((link) => (
          <li>
            <p class="rotulo">{LABEL_TEXT[link.label] ?? link.label}</p>
            <p class="titulo">{link.title}</p>
            <p class="meta">
              {link.sourceName} ·{" "}
              {formatBRT(link.publishedAt ?? link.createdAt)}
            </p>
            <div class="acoes">
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                Ler na fonte
              </a>
              {comentarHref && <a href={comentarHref}>Comentar</a>}
            </div>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  section {
    padding: 0;
  }

  h2 {
    font-size: var(--type-lg);
    margin-block-end: var(--space-2);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--color-paper-muted);
  }

  .rotulo {
    font-size: var(--type-xs);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .titulo {
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: var(--type-xl);
    font-weight: var(--font-display-weight);
  }

  .meta {
    font-size: var(--type-sm);
    color: var(--color-ink-muted);
  }

  .acoes {
    display: flex;
    gap: var(--space-4);
    margin-block-start: var(--space-1);
  }

  .acoes a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--size-tap-target-min);
  }

  .empty-editorial {
    border: 1px solid var(--color-paper-muted);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .empty-editorial > span {
    display: block;
    color: var(--color-accent);
    font-size: var(--type-xl);
    margin-block-end: var(--space-3);
  }

  .empty-editorial .meta {
    margin-block-start: var(--space-2);
  }

  @media (width >= 64rem) {
    ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }

    li {
      border-block-start: 3px solid var(--color-accent);
      border-block-end: 0;
      padding-block: var(--space-4);
    }

    .acoes {
      margin-block-start: auto;
      gap: var(--space-3);
      font-size: var(--type-sm);
      flex-wrap: wrap;
    }

    .titulo {
      margin-block: var(--space-2);
    }
  }
</style>
