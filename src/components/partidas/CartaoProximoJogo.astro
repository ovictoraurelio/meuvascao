---
import { formatKickoff } from "@/lib/match-kickoff";
import {
  MATCH_STATUS_LABEL,
  type MatchStatusValue,
} from "@/lib/match-status-label";

// Forma estrutural, não importada de @/modules/partidas: componentes de apresentação não
// importam módulos de domínio (eslint no-restricted-imports), mesmo só para o tipo.
interface ProximoJogo {
  slug: string;
  opponentName: string;
  competition: string;
  homeAway: "casa" | "fora" | "neutro";
  kickoffAt: Date | null;
  kickoffPrecision: "confirmado" | "indefinido";
  venue: string | null;
  status: MatchStatusValue;
}

interface Props {
  match: ProximoJogo | null;
}

const { match } = Astro.props;
---

<section class="cartao" data-testid="dia-de-vasco" aria-label="Dia de Vasco">
  <p class="eyebrow">Próxima batalha</p><h2>Dia de Vasco</h2><img
    class="escudo"
    src="/brand/vasco.svg"
    alt="Escudo do Vasco da Gama"
    width="80"
    height="100"
  />
  {
    match ? (
      <>
        <p class="adversario">
          Vasco {match.homeAway === "casa" ? "x" : "×"} {match.opponentName}
        </p>
        <p class="detalhes">
          {match.competition}
          {MATCH_STATUS_LABEL[match.status] &&
            ` · ${MATCH_STATUS_LABEL[match.status]}`}
        </p>
        <p class="horario">
          {formatKickoff(match)}
          {match.venue && ` · ${match.venue}`}
        </p>
        <a href={`/jogos/${match.slug}#comentar`} class="cta">
          Ver jogo e entrar na resenha
        </a>
      </>
    ) : (
      <>
        <>
          <p>Ainda não há o próximo jogo do Vasco cadastrado.</p>
          <a class="cta" href="/jogos">
            Acompanhe a agenda <span aria-hidden="true">→</span>
          </a>
        </>
      </>
    )
  }
  <p class="match-footer">
    Aqui a torcida joga junto. <span aria-hidden="true">✠</span>
  </p>
</section>

<style>
  .cartao {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background-color: var(--color-ink);
    color: var(--color-paper);
  }

  .cartao h2 {
    font-size: var(--type-lg);
  }

  .cartao p {
    font-size: var(--type-sm);
    color: var(--color-paper-muted);
  }

  .cartao .adversario {
    font-family: var(--font-display);
    font-size: var(--type-xl);
    font-weight: var(--font-display-weight);
    color: var(--color-paper);
  }

  .cta {
    gap: var(--space-3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--size-tap-target-min);
    margin-block-start: var(--space-2);
    padding-inline: var(--space-4);
    color: var(--color-ink);
    text-align: center;
    background-color: var(--color-paper);
    border-radius: var(--radius-md);
  }

  .cta:hover {
    text-decoration: none;
  }

  .escudo {
    inline-size: 48px;
    block-size: 60px;
    align-self: center;
    margin-block: var(--space-4);
    object-fit: contain;
  }

  .cartao .eyebrow {
    font-size: var(--type-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .cartao .match-footer {
    text-align: center;
    font-size: var(--type-xs);
    margin-block-start: var(--space-3);
  }

  @media (width >= 64rem) {
    .escudo {
      inline-size: 80px;
      block-size: 100px;
    }

    .cartao {
      border: 1px solid var(--color-paper-muted);
      border-radius: var(--radius-md);
      background: var(--color-paper);
      color: var(--color-ink);
      padding: var(--space-5);
      min-block-size: 28rem;
    }

    .cartao p {
      color: var(--color-ink-muted);
    }

    .cartao .adversario {
      color: var(--color-ink);
      font-size: var(--type-2xl);
      text-align: center;
    }

    .cartao .detalhes,
    .cartao .horario {
      text-align: center;
    }

    .cartao .eyebrow {
      color: var(--color-accent);
    }

    .cartao h2 {
      font-size: var(--type-xl);
    }

    .cta {
      background: var(--color-accent);
      color: var(--color-paper);
      margin-block-start: auto;
    }
  }
</style>
