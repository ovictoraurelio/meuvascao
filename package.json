{
  "name": "meu-vascao",
  "version": "1.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Portal independente de torcedores do Vasco: dia de jogo, resenha e links curados.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "CLOUDFLARE_ENV=preview astro build",
    "build:production": "CLOUDFLARE_ENV=production astro build",
    "serve:built": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state --port 8788",
    "preview": "npm run build && npm run serve:built",
    "types": "wrangler types",
    "check": "npm run check:actions && npm run check:format && npm run check:lint && npm run check:types",
    "check:actions": "node scripts/check-actions-pinned.mjs",
    "check:format": "prettier --check --cache .",
    "check:lint": "eslint --cache . && stylelint \"src/**/*.{css,astro}\" --allow-empty-input",
    "check:types": "npm run types && astro check",
    "format": "prettier --write --cache .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:reset": "sh scripts/db-reset-local.sh",
    "test": "npm run test:vitest && npm run test:e2e",
    "test:vitest": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:e2e": "astro build && playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "astro": "7.3.1",
    "drizzle-orm": "0.45.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.12.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
